{
  "servers": {
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-azure-selfhosted"
      ],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/your-organization",
        "AZURE_DEVOPS_PAT": "your-personal-access-token-here",
        "AZURE_DEVOPS_PROJECT": "your-default-project",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  }
}
