{
  "name": "mcp-azure-selfhosted",
  "version": "1.1.0",
  "description": "MCP server for self-hosted Azure DevOps instance with Personal Access Token authentication",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-azure-selfhosted": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "self-hosted",
    "model-context-protocol",
    "claude",
    "ai-assistant",
    "work-items"
  ],
  "author": "edrich13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edrich13/mcp-azure-selfhosted.git"
  },
  "bugs": {
    "url": "https://github.com/edrich13/mcp-azure-selfhosted/issues"
  },
  "homepage": "https://github.com/edrich13/mcp-azure-selfhosted#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ]
}
